# Pico FinOps Agent settings. Copy to .env, `chmod 600 .env`, never commit it.
# Placeholder values below (account 111122223333).
# AWS access keys do NOT go here: the EC2 instance role is used (IMDSv2, hop limit 1; compose uses host networking).

# --- Image (docker-compose.yml) ---
# The release to run: ghcr.io/cloudpiai/pico:<tag> (see the repository's Releases page). Pinning a
# version means an update happens only when you change it; default: latest. Each release has two equal tags,
# X.Y.Z and vX.Y.Z (for example 0.4.0 or v0.4.0); either works here. Up to 0.3.0 the image was
# ghcr.io/cloudpiai/pico-finops-agent; that name still gets the same image for now.
# (Building it yourself with docker-compose.build.yml always makes pico-finops-agent:local and ignores this.)
# AGENT_IMAGE_TAG=0.3.0

# --- AWS (required) ---
FOCUS_REGION=us-east-1
FOCUS_EXPORT_BUCKET=acme-focus-export
# Key path inside the bucket up to and including data/, ending with / (e.g. focus2/focus2/data/).
# Not an s3:// URL and without the bucket name. Both AWS export settings work ("Create new" and "Overwrite").
FOCUS_EXPORT_PREFIX=focus/acme-focus/data/
FOCUS_TABLE_BUCKET_ARN=arn:aws:s3tables:us-east-1:111122223333:bucket/acme-focus
FOCUS_STATE_BUCKET=acme-focus-state
FOCUS_LAMBDA_ROLE_ARN=arn:aws:iam::111122223333:role/pico-finops-agent-loader-role

# --- AWS (optional, defaults shown) ---
# FOCUS_NAMESPACE=pico_finops_agent
# FOCUS_TABLE=focus
# FOCUS_STATE_KEY=pico-finops-agent/state.json
# How many months of cost data to keep, counting the current month (4 in November = Aug..Nov); older months
# are not loaded, and are removed from the S3 Table and the local copy
# (2 or more keeps the notice's 7-day and 30-day comparisons working early in a month)
# FOCUS_MONTHS=4
# Cron, UTC: twice a day
# FOCUS_SCHEDULE=0 6,18 * * *

# --- Post-load Slack notice: what counts as a sudden increase (defaults shown; used when unset) ---
# A day at least this % above its 7-day average ...
# FOCUS_ALERT_INCREASE_PCT=50
# ... and at least this many USD above it, per service / per resource
# FOCUS_ALERT_MIN_SERVICE_USD=1
# FOCUS_ALERT_MIN_RESOURCE_USD=0.5
# Warn in Slack when the newest cost data is older than this many days (a stopped AWS export)
# FOCUS_ALERT_STALE_DAYS=3

# --- LLM (required): the model that answers questions in Slack ---
# Which provider: gemini (default), openai, anthropic (or claude), deepseek. Set the key of the one you choose.
# AGENT_LLM_PROVIDER=gemini
# Optional: the provider's model. Defaults: gemini-3.8-flash, gpt-5.5, claude-sonnet-4-6, deepseek-v4-pro
# AGENT_LLM_MODEL=
GEMINI_API_KEY=
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# DEEPSEEK_API_KEY=

# --- Slack (optional; set both to turn the Slack bot on) ---
# SLACK_APP_TOKEN=
# SLACK_BOT_TOKEN=
# Optional: post a note in this channel after a scheduled load brings new data (channel name or ID; needs the bot token)
# SLACK_NOTIFY_CHANNEL=pico-finops-agent
# Slack answers (optional; defaults shown). The model sees only the last N questions of a conversation (1-50)
# AGENT_HISTORY_TURNS=8
# A question still running after this many seconds is stopped with a "too long" note (30-900)
# AGENT_ANSWER_DEADLINE_S=180
# Questions per person per hour; more get a "please wait" note (0 = no limit)
# AGENT_QUESTIONS_PER_HOUR=30
# 1 = keep the request of each empty or failed model call in <data dir>/llm-failures/ (newest 50, owner-only) so it
# can be replayed. The files hold your cost data and questions: leave 0 unless you are debugging (0 or 1)
# AGENT_SAVE_FAILED_CALLS=0

# --- Scheduled Slack tasks (optional; defaults shown; reminders, reports, saved queries, recurring questions) ---
# Slack app scopes needed: chat:write, channels:read, groups:read, im:write, users:read
# Channel IDs tasks may post to, comma-separated; unset or empty = any channel the bot is in (DMs always allowed)
# FOCUS_REPORT_CHANNELS=
# Slack user IDs that may set up tasks that post in a channel; unset = nobody (anyone can still schedule to their DM)
# FOCUS_REPORT_CREATORS=
# Slack user IDs that may stop or change any task without the creator; unset = only the creator
# FOCUS_REPORT_ADMINS=
# Changes kept in each task's history (its "created" line and latest "removed" line are always kept)
# FOCUS_REPORT_HISTORY_MAX=5
# "ask" tasks (the agent answers a saved question each time) per day, all tasks together
# FOCUS_ASK_MAX_PER_DAY=1000
# Let reminders use @channel / @here / @everyone
# FOCUS_REPORT_ALLOW_MENTIONS=false
