# Slack end-to-end test of the standalone agent (Playwright in the Slack web app). Copy to .env (git-ignored)
# or to ~/.pico-e2e/e2e.env (mode 600) and fill in. Only names and ids here: the sign-in is a saved browser
# session (E2E_STATE_FILE), made once with `python -m tests.e2e.standalone_ui.login`. Never put a password here.

# --- the Slack workspace ---
# The workspace URL you open in the browser
E2E_SLACK_URL=https://yourco.slack.com
# Team id (T...): the part after /client/ in https://app.slack.com/client/<team>/...
E2E_TEAM_ID=T0000000000

# --- the bot under test (the agent's Slack app; its name differs per install, e.g. "Pico FinOps Agent" or "Pico") ---
E2E_BOT_NAME=Pico FinOps Agent
# The bot's member id (U...). Optional: found from its profile link when empty
E2E_BOT_USER=
# The DM with the bot (D...). Optional: opened from the sidebar by E2E_BOT_NAME when empty
E2E_BOT_DM=

# --- the test user (the account in the saved session) ---
# Your member id (U...). Optional: read from the page when empty
E2E_ME=

# --- channels (ids C..., comma-separated where a list is allowed) ---
# Channels with you and the bot in them; channel cases run in each. Empty: channel cases are SKIP
E2E_TEST_CHANNELS=
# A channel the bot is NOT in (refusal case). Empty: that case is SKIP
E2E_OUTSIDE_CHANNEL=
# The agent's SLACK_NOTIFY_CHANNEL (read only: the newest notice is a known kind). Empty: that case is SKIP
E2E_NOTIFY_CHANNEL=

# --- sign-in and data ---
# Saved browser session (cookies) from the login script; keep it mode 600 and outside the repo
E2E_STATE_FILE=~/.pico-e2e/state.json
# The agent container: its /data/focus.duckdb is copied (docker cp) to compute the expected figures
E2E_AGENT_CONTAINER=pico-finops-agent
# Or a focus.duckdb copy you already have (used instead of E2E_AGENT_CONTAINER when set)
E2E_DATA_COPY=

# --- run ---
# Where the report (report.json, report.html, run.log) and failure screenshots go
E2E_REPORT_DIR=~/.pico-e2e/runs
# true on a server; false shows the browser
E2E_HEADLESS=true
# Waits, in seconds: an answer, a task change, a scheduled post to arrive
E2E_ANSWER_TIMEOUT_S=180
E2E_TASK_TIMEOUT_S=240
E2E_DELIVER_TIMEOUT_S=480
